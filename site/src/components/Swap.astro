---
// Hero: the swap animation, its controls and its caption. The math labels are
// rendered here at build time and handed to the client as HTML.
import hero from "../data/hero.json";
import { tex } from "../scripts/tex.js";
import M from "./M.astro";

interface Props { embed?: boolean }
const { embed = false } = Astro.props;
const short: Record<string, string> = {
  answerPosition: "options reordered",
  answerPosition_randomLetter: "new option symbols",
};
const s = hero.setup;
const model = s.model.split("/").pop();
const labels = {
  s: tex("\\mathbf{s}"), b: tex("\\mathbf{b}"),
  qs: tex("q(\\mathbf{s})"), qb: tex("q(\\mathbf{b})"), qbs: tex("q(\\bh_{b \\leftarrow s})"),
  kl: tex("\\mathrm{KL}\\big(q(\\mathbf{s})\\,\\|\\,q(\\bh_{b \\leftarrow s})\\big)"),
};
const steps = [
  `Read both answers, ${tex("q(\\mathbf{b})")} and ${tex("q(\\mathbf{s})")}`,
  `Project the donor onto ${tex("\\Psi")}: ${tex("\\bpi\\,\\bh_s")}`,
  `Swap: ${tex("\\bh_{b \\leftarrow s} = \\bpi\\,\\bh_s + (\\mathrm{I} - \\bpi)\\,\\bh_b")}`,
  `Read again: the recipient answers at the donor's position`,
];
---
<div class:list={["swap-host", { embed }]} data-embed={embed ? "1" : undefined} data-labels={JSON.stringify(labels)} data-steps={JSON.stringify(steps)}>
  <div class="swap-root" aria-live="off"></div>
  {!embed && (
    <div class="swap-controls">
      <button class="button play" type="button" aria-pressed="false">
        <svg viewBox="0 0 16 16" aria-hidden="true"><path class="icon-pause" d="M4 3h3v10H4zM9 3h3v10H9z" /><path class="icon-play" d="M4 2.5v11l9-5.5z" /></svg>
        <span class="label">pause</span>
      </button>
      <div class="seg pair-toggle" role="group" aria-label="Which test pair to show">
        <button type="button" data-pair="auto" aria-pressed="true">both pairs</button>
        {hero.pairs.map((p, i) => <button type="button" data-pair={i} aria-pressed="false">{short[p.family] ?? p.family}</button>)}
      </div>
    </div>
  )}
  {!embed && (
    <p class="swap-caption">
      {model}, MCQA, layer {s.layer}, last token, {s.target} target, rank {s.rank}, seed {s.seed}. Two test pairs
      from the benchmark, each the median-KL pair of its family. The plane spans two of the subspace's {s.rank}
      directions, which hold {hero.view.plane_share.display}% of the test activations' variance inside it; the vertical
      axis is the main direction of variance outside it. Each letter is one of the 200 test prompts, marked by the
      option the model picks. Over 150 test pairs and three seeds, <M t={String.raw`\mathrm{KL}\big(q(\mathbf{s})\,\|\,q(\bh_{b \leftarrow s})\big)`} /> averages
      <span class="psi-ink">{hero.kl_mean.display}</span> nats.
    </p>
  )}
  <noscript><p class="small muted">The animation needs JavaScript.</p></noscript>
</div>

<script>
  import hero from "../data/hero.json";
  import { createSwap } from "../scripts/swap.js";

  for (const host of document.querySelectorAll<HTMLElement>(".swap-host")) {
    const root = host.querySelector<HTMLElement>(".swap-root")!;
    const params = new URLSearchParams(location.search);
    const embed = host.dataset.embed === "1";
    const pairParam = params.get("pair");
    const timeParam = params.get("t");
    const swap = createSwap(root, hero, {
      pair: pairParam !== null ? Number(pairParam) : null,
      time: timeParam !== null ? Number(timeParam) : undefined,
      reducedMotion: embed ? false : undefined,
      labels: JSON.parse(host.dataset.labels!),
      steps: JSON.parse(host.dataset.steps!),
    });
    (window as any).__psiSwap = swap;

    const button = host.querySelector<HTMLButtonElement>(".play");
    const sync = () => {
      if (!button) return;
      button.setAttribute("aria-pressed", String(!swap.playing));
      button.querySelector(".label")!.textContent = swap.playing ? "pause" : "play";
      button.classList.toggle("paused", !swap.playing);
    };
    root.addEventListener("swap:state", sync);
    let userPaused = false;
    button?.addEventListener("click", () => {
      if (swap.playing) { swap.pause(); userPaused = true; } else { swap.play(); userPaused = false; }
    });
    host.querySelectorAll<HTMLButtonElement>(".pair-toggle button").forEach((b) =>
      b.addEventListener("click", () => {
        const k = b.dataset.pair === "auto" ? null : Number(b.dataset.pair);
        host.querySelectorAll(".pair-toggle button").forEach((o) => o.setAttribute("aria-pressed", String(o === b)));
        swap.setPair(k);
      }));

    const still = timeParam !== null || params.get("still") === "1";
    const reduced = matchMedia("(prefers-reduced-motion: reduce)").matches && !embed;
    if (!still && !reduced) {
      // Play only while visible.
      new IntersectionObserver(([entry]) => {
        if (entry.isIntersecting && !userPaused && !document.hidden) swap.play();
        else swap.pause();
      }, { threshold: 0.15 }).observe(root);
      document.addEventListener("visibilitychange", () => {
        if (document.hidden) swap.pause(); else if (!userPaused) swap.play();
      });
    }
    sync();
  }
</script>

<style is:global>
  .swap-host { --pair-fade: 1; }
  .swap { display: grid; grid-template-columns: minmax(0, 1fr) minmax(0, 1.4fr) minmax(0, 1fr); gap: 28px; align-items: start; }
  .swap-card { opacity: var(--pair-fade); padding-top: 4px; }
  .card-head { display: flex; justify-content: space-between; align-items: baseline; gap: 8px; margin-bottom: 10px; color: var(--ink-soft); font-size: 1rem; }
  .card-head .role { font-style: italic; font-size: 1.12rem; }
  .card-head .role.donor { color: var(--donor-ink); }
  .card-head .role.recipient { color: var(--recipient-ink); }
  .card-head b { font-family: var(--mono); font-weight: 400; color: var(--ink); }
  .card-head b.edited { color: var(--psi-ink); }
  .prompt { font-family: var(--mono); font-size: 0.86rem; line-height: 1.5; color: var(--ink-soft); min-height: 9.4em; }
  .prompt .line { padding: 0 0.35rem; border-left: 2px solid transparent; transition: background-color 0.25s ease, color 0.25s ease, border-color 0.25s ease; }
  .prompt .line:first-child { color: var(--ink); margin-bottom: 0.2rem; }
  .prompt .hl-donor { background: var(--donor-wash); color: var(--donor-ink); border-left-color: var(--donor); }
  .prompt .hl-recipient { background: var(--recipient-wash); color: var(--recipient-ink); border-left-color: var(--recipient); }
  .prompt .hl-edited { background: var(--psi-wash); color: var(--psi-ink); border-left-color: var(--psi); }
  .swap svg.bars { display: block; width: 100%; height: auto; margin-top: 10px; overflow: visible; }
  .bars-caption { text-align: center; color: var(--ink-soft); min-height: 1.6em; position: relative; }
  .bars-caption > span { transition: opacity 0.25s ease; }
  .bars-caption .cap-after { position: absolute; left: 0; right: 0; opacity: 0; color: var(--psi-ink); }
  .swap-card.read .bars-caption .cap-before { opacity: 0; }
  .swap-card.read .bars-caption .cap-after { opacity: 1; }
  .bar.donor { fill: var(--donor); }
  .bar.recipient { fill: var(--recipient); }
  .bar-outline { fill: none; stroke: var(--donor-ink); stroke-width: 1.3; stroke-dasharray: 3 2.5; }
  .bar-value { font: 400 11.5px var(--serif); fill: var(--ink-soft); }
  .bar-label { font: 400 13px var(--mono); fill: var(--ink); }
  .baseline { stroke: var(--ink-soft); stroke-width: 0.8; }
  .kl { margin-top: 8px; color: var(--ink-soft); display: flex; align-items: center; justify-content: center; gap: 8px; font-size: 0.95rem; }
  .legend-outline { display: inline-block; flex: none; width: 14px; height: 10px; border: 1.3px dashed var(--donor-ink); }

  svg.space { display: block; width: 100%; height: auto; }
  svg.space text { font-family: var(--serif); }
  .plane { fill: var(--psi-wash); stroke: var(--psi); stroke-width: 1; }
  .plane-label { font-size: 12.5px; font-style: italic; fill: var(--psi-ink); }
  .cloud text { font: 400 9.5px var(--mono) !important; fill: var(--ink-muted); }
  .cloud.above text { opacity: 0.85; }
  .cloud.below text { opacity: 0.4; }
  .axis line { stroke: var(--ink-soft); stroke-width: 0.8; stroke-dasharray: 2 3; }
  .axis text { font-size: 11px; font-style: italic; fill: var(--ink-soft); }
  .marks { opacity: var(--pair-fade); }
  .drop { stroke-width: 1.3; stroke-dasharray: 3 3; }
  .drop.recipient { stroke: var(--recipient); }
  .drop.donor { stroke: var(--donor); }
  .drop.edited { stroke: var(--psi); }
  .trail { stroke: var(--psi); stroke-width: 2.2; stroke-linecap: round; }
  .foot.donor { fill: var(--bg); stroke: var(--psi); stroke-width: 2; }
  .foot.recipient { fill: var(--recipient); }
  .ghost { fill: none; stroke: var(--recipient); stroke-width: 1.2; stroke-dasharray: 2 2; }
  .point { stroke: var(--bg); stroke-width: 2; }
  .point.donor { fill: var(--donor); }
  .point-label { font-size: 13px; font-style: italic; paint-order: stroke; stroke: var(--bg); stroke-width: 3.5px; }
  .point-label.donor { fill: var(--donor-ink); }
  .point-label.recipient { fill: var(--recipient-ink); }
  .point-label.recipient.edited { fill: var(--psi-ink); }
  .foot-label { font-size: 12px; font-style: italic; fill: var(--psi-ink); paint-order: stroke; stroke: var(--bg); stroke-width: 3.5px; }

  .steps { list-style: none; margin: 6px 0 0; padding: 0; display: grid; gap: 2px; font-size: 0.98rem; }
  .steps li { display: flex; gap: 0.5rem; align-items: baseline; color: var(--ink-muted); transition: color 0.25s ease; }
  .steps li .num { flex: none; width: 1.3rem; text-align: right; }
  .steps li.done { color: var(--ink-soft); }
  .steps li.active { color: var(--ink); }
  .steps li.active .num { color: var(--psi-ink); }

  .swap-controls { display: flex; flex-wrap: wrap; gap: 12px; align-items: center; justify-content: center; margin-top: 22px; }
  .play { padding: 0.24rem 0.8rem; font-size: 0.95rem; }
  .play .icon-play { display: none; }
  .play.paused .icon-play { display: inline; }
  .play.paused .icon-pause { display: none; }
  .play svg path { fill: currentColor; }
  .swap-caption { margin: 18px auto 0; max-width: 880px; text-align: center; color: var(--ink-muted); font-size: 0.92rem; }

  @media (max-width: 860px) {
    .swap { grid-template-columns: minmax(0, 1fr) minmax(0, 1fr); gap: 16px; }
    .swap-stage { grid-column: 1 / -1; order: -1; }
    .prompt { font-size: 0.72rem; min-height: 0; }
    .card-head { flex-direction: column; gap: 0; font-size: 0.88rem; }
    .steps { font-size: 0.9rem; }
  }

  /* Slides: the whole viewport, larger type. */
  html.embed body { overflow: hidden; }
  .swap-host.embed { width: 100vw; height: 100vh; display: grid; place-items: center; padding: 3vh 3vw; }
  .swap-host.embed .swap { width: min(94vw, 168vh); gap: 2.4vw; }
  .swap-host.embed .prompt { font-size: clamp(0.85rem, 1.1vw, 1.45rem); }
  .swap-host.embed .card-head { font-size: clamp(1rem, 1.2vw, 1.6rem); }
  .swap-host.embed .bars-caption, .swap-host.embed .kl { font-size: clamp(1rem, 1.15vw, 1.5rem); }
  .swap-host.embed .steps { font-size: clamp(1rem, 1.2vw, 1.6rem); }
  html.embed[data-bg="none"], html.embed[data-bg="none"] body { background: transparent; }
</style>
