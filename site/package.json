{
  "name": "psi-project-page",
  "private": true,
  "type": "module",
  "description": "Project page for the PSI paper. The data in src/data is exported from the experiments reported in the paper; no number is typed by hand.",
  "scripts": {
    "dev": "ASTRO_TELEMETRY_DISABLED=1 astro dev --host 0.0.0.0",
    "build": "ASTRO_TELEMETRY_DISABLED=1 astro build",
    "preview": "ASTRO_TELEMETRY_DISABLED=1 astro preview --host 0.0.0.0",
    "screenshots": "node scripts/screenshots.mjs",
    "record": "node scripts/record.mjs"
  },
  "dependencies": {
    "@astrojs/markdown-remark": "7.3.9",
    "astro": "6.4.8",
    "computer-modern": "0.1.3",
    "d3": "7.9.0",
    "katex": "0.16.47",
    "rehype-katex": "7.0.1",
    "remark-math": "6.0.0",
    "sanitize-html": "2.18.2"
  },
  "devDependencies": {
    "playwright": "1.64.1"
  },
  "overrides": {
    "vite": "7.3.8"
  }
}
